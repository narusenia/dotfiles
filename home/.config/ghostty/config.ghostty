window-padding-x=24
window-padding-y=24
macos-titlebar-style=tabs
background-opacity=0.75
background-blur=true
macos-icon=blueprint
theme=Aizen Dark
theme=Cutie Pro

font-family=Ioskeley Mono Term
# shortcut: family name unverified (font not installed on this mac); check with `ghostty +list-fonts`
font-family-italic=Obel Mono
# font-family=Berkeley Mono
# font-family=DMMono Nerd Font Mono
font-family=BIZ UDGothic
font-feature=+zero, +cv02, +cv06, +cv01, +ss02, +ss01, +cv08

custom-shader = ./shaders/cursor_warp.glsl
